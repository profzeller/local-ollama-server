# Ollama Configuration
# Copy this to .env and customize

# ==============================================
# Default Model to Pull on Startup
# ==============================================
# This model will be pulled automatically when the container starts.
# You can pull additional models later with: docker exec ollama ollama pull <model>
#
# Popular models for 16GB VRAM:
#   - mistral:7b (7B, fast, great quality)
#   - llama3.2:3b (3B, very fast)
#   - qwen2.5:7b (7B, multilingual)
#   - phi3:mini (3.8B, efficient)
#   - gemma2:9b (9B, good quality)
#
# For 24GB+ VRAM:
#   - qwen2.5:14b (14B, excellent quality)
#   - llama3.1:8b (8B, good balance)
#
# ==============================================

# Default model to pull on container start
OLLAMA_DEFAULT_MODEL=mistral:7b

# ==============================================
# Performance Settings
# ==============================================

# Number of parallel requests (reduce if OOM, increase for more throughput)
# RTX 4090 16GB: 4 is a good balance
OLLAMA_NUM_PARALLEL=4

# Max models loaded in memory simultaneously
# Keep at 1 unless you have 24GB+ VRAM
OLLAMA_MAX_LOADED_MODELS=1

# Keep model in memory (use time units: 5m, 1h, etc.)
# Longer = faster responses, shorter = less idle VRAM usage
OLLAMA_KEEP_ALIVE=5m

# Enable Flash Attention for faster inference on RTX 30/40 series
# Set to 0 to disable if you experience issues
OLLAMA_FLASH_ATTENTION=1

# ==============================================
# Network Settings
# ==============================================

# Bind address (0.0.0.0 for external access)
OLLAMA_HOST=0.0.0.0

# Port
OLLAMA_PORT=11434
